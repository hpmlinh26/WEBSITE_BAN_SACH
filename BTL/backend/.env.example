# Sao chep file nay thanh .env va dien gia tri khi chay LOCAL.
# (Tren Render: cau hinh cac bien nay trong render.yaml / Dashboard, khong can file .env.)

# Cong + DB
PORT=3000
# DATABASE_PATH=/var/data/database.sqlite   # khi deploy co persistent disk
# DATA_DIR=/var/data

# URL goc cua app (de MoMo redirect ve sau khi thanh toan).
# Local: http://localhost:3000. Render: tu dong dung RENDER_EXTERNAL_URL neu khong dat.
APP_BASE_URL=http://localhost:3000

# JWT secret (doi thanh chuoi ngau nhien khi deploy that)
AUTH_SECRET=mot-store-demo-auth-secret

# ===== Thanh toan MoMo (sandbox) =====
# Bo credential TEST cong khai cua MoMo (developers.momo.vn).
# Khi deploy that, dang ky merchant rieng va dien lai 3 gia tri dau.
